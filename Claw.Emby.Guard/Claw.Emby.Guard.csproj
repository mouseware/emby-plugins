<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Claw.Emby.Guard</AssemblyName>
    <RootNamespace>Claw.Emby.Guard</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Override: /p:EmbyServerPath=C:\Users\...\AppData\Roaming\Emby-Server\system -->
    <EmbyServerPath Condition="'$(EmbyServerPath)' == ''">$(MSBuildThisFileDirectory)refs</EmbyServerPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="MediaBrowser.Common"><HintPath>$(EmbyServerPath)\MediaBrowser.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Controller"><HintPath>$(EmbyServerPath)\MediaBrowser.Controller.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Model"><HintPath>$(EmbyServerPath)\MediaBrowser.Model.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Web\guard.html" />
    <EmbeddedResource Include="Web\guard.js" />
    <EmbeddedResource Include="Images\thumb.png" />
  </ItemGroup>
</Project>
